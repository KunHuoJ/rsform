{
  "name": "rsform",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "description": "High-performance React form library built on Formily v2 with antd 5 — effect-driven, auto-injecting Field, and a fast editable Table that won't re-render every cell.",
  "license": "MIT",
  "author": "",
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "docs:dev": "pnpm -F rsform-docs dev",
    "docs:build": "pnpm -F rsform-docs build",
    "docs:preview": "pnpm -F rsform-docs preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check --write",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "@formily/core": "^2.3.0",
    "@formily/react": "^2.3.0",
    "antd": "^5.21.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@formily/reactive": "^2.3.0",
    "@formily/reactive-react": "^2.3.0",
    "@formily/shared": "^2.3.0",
    "hoist-non-react-statics": "^3.3.2",
    "immer": "^11.2.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@formily/core": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@rslib/core": "^1.0.4",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dayjs": "^1.11.13",
    "@vitejs/plugin-react": "^4.3.0",
    "antd": "^5.29.3",
    "jsdom": "^25.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rsbuild-plugin-dts": "^1.0.4",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "form",
    "formily",
    "antd",
    "table",
    "editable-table",
    "reactive"
  ]
}
